[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

uniform vec2 hole_center = vec2(0.0);
uniform float hole_radius = 0.0;
uniform vec2 viewport_size = vec2(1.0);
uniform vec4 shade_color : hint_color = vec4(0.0, 0.0, 0.0, 0.427451);

void fragment() {
	float distance_to_hole = distance(UV * viewport_size, hole_center);
	float shade = smoothstep(hole_radius, hole_radius + 1.0, distance_to_hole);
	COLOR = vec4(shade_color.rgb, shade_color.a * shade);
}
"

